# Remember to never publicly share your keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks

# Fastlane run artefacts. fastlane/metadata/ is deliberately NOT ignored: it is the source of
# truth for the Play Store listing.
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output
fastlane/README.md

# Bundler installs fastlane here (BUNDLE_PATH in .bundle/config) — Homebrew's shared gem dir
# symlinks read-only files into the Cellar, so a global install can die with EACCES while
# regenerating gem plugins. Mirrors the same rule in ios/.gitignore.
vendor/bundle/
